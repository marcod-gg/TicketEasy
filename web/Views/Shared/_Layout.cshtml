@inject Microsoft.Extensions.Configuration.IConfiguration Config
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @Config["Producto:Nombre"]</title>
    <meta name="theme-color" content="#171310" />
    <script>
        // Bootstrap sigue al tema del sistema, igual que los tokens --fi-*
        (m => { const set = () => document.documentElement.dataset.bsTheme = m.matches ? 'dark' : 'light'; set(); m.addEventListener('change', set); })(matchMedia('(prefers-color-scheme: dark)'));
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&family=DM+Serif+Display&display=swap" />
    <script src="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@@2.1.1"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap-bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
