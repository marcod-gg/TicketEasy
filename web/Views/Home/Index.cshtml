@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Tickets";
    var producto = Config["Producto:Nombre"];
}

<div id="app" data-url="@Config["Supabase:Url"]" data-key="@Config["Supabase:PublishableKey"]" data-producto="@producto">

    <section id="login" class="nx-login" hidden>
        <div class="nx-login__art">
            <span class="fi-brand on-dark" translate="no"><span class="fi-brand-mark" aria-hidden="true"></span>@producto</span>
            <div>
                <p class="fi-eyebrow nx-login__eyebrow">Mesa de ayuda</p>
                <h1>Cada solicitud, <span>con dueño y estado.</span></h1>
                <p class="nx-login__lead">Pide ayuda, sigue el avance y confirma cuando quede resuelto.</p>
            </div>
        </div>
        <form id="loginForm" class="nx-login__form">
            <h2>Ingresar</h2>
            <p class="text-body-secondary">Usa la cuenta de tu empresa.</p>
            <label class="nx-field"><span>Correo</span><input id="email" type="email" class="form-control" required autocomplete="username"></label>
            <label class="nx-field"><span>Contraseña</span><input id="pass" type="password" class="form-control" required autocomplete="current-password"></label>
            <button class="btn btn-primary w-100" id="loginBtn">Entrar <i class="ph ph-arrow-right" aria-hidden="true"></i></button>
            <p class="nx-error" id="loginMsg" role="alert"></p>
        </form>
    </section>

    <div id="shell" class="nx-app" hidden>
        <a class="nx-skip" href="#vista">Saltar al contenido</a>
        <aside class="nx-side">
            <div class="nx-side__brand">
                <span class="fi-brand on-dark" translate="no"><span class="fi-brand-mark" aria-hidden="true"></span>@producto</span>
            </div>
            <label class="nx-org"><span>Empresa</span><b id="empNombre"></b><select id="empSel" class="form-select form-select-sm" hidden></select></label>
            <nav id="nav" class="nx-nav" aria-label="Secciones"></nav>
            <div class="nx-side__foot">
                <span id="who" class="nx-who"></span>
                <button class="nx-iconbtn" id="logout" aria-label="Cerrar sesión" title="Cerrar sesión"><i class="ph ph-sign-out" aria-hidden="true"></i></button>
            </div>
        </aside>

        <main id="vista" class="nx-main" tabindex="-1">
            <p id="lectura" class="nx-banner" role="status" hidden>
                <i class="ph ph-lock-simple" aria-hidden="true"></i>
                El plan de TicketEasy de tu empresa venció. Puedes consultar tus tickets durante el período de gracia, pero no crear ni responder.
            </p>
            <header class="nx-head">
                <div>
                    <p class="fi-eyebrow" id="eyebrow"></p>
                    <h1 id="titulo"></h1>
                    <p class="nx-head__sub" id="bajada"></p>
                </div>
                <div class="nx-head__actions" id="acciones"></div>
            </header>
            <p class="nx-error" id="msg" role="alert"></p>
            <div id="contenido"></div>
        </main>
    </div>

    <dialog id="dlg" class="nx-dialog" aria-labelledby="dlgTitulo"><form id="frm" novalidate></form></dialog>

    <div id="toasts" class="nx-toasts" aria-live="polite"></div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.7/dist/purify.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@supabase/supabase-js@@2"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
}
